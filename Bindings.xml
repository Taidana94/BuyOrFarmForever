<Bindings>
	<!-- Key bindings (Esc > Key Bindings > AddOns). Names: UI/MinimapButton.lua sets the BINDING_* strings. -->
	<Binding name="GOLDCOMPASS_TOGGLE" header="GOLDCOMPASS" category="ADDONS">
		GoldCompass.MainWindow.Toggle()
	</Binding>
	<Binding name="GOLDCOMPASS_FARM" category="ADDONS">
		GoldCompass.MinimapButton.ToggleFarmRun()
	</Binding>
	<Binding name="GOLDCOMPASS_ADVISOR" category="ADDONS">
		GoldCompass.AdvisorWindow.Toggle()
	</Binding>
</Bindings>
